{
  "expo": {
    "name": "Dynavox Inventory",
    "slug": "dynavox-inventory",
    "scheme": "dynavox",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ch.dynavox.inventory",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ch.dynavox.inventory",
      "adaptiveIcon": {
        "backgroundColor": "#3B5BE8",
        "foregroundImage": "./assets/logo.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-router",
      "expo-status-bar",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#361826"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to scan barcodes and photograph devices.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to attach photos to repairs.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to take photos for repairs.",
          "microphonePermission": false
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "apiUrl": "https://dynservice.dynavox.ch/api"
    }
  }
}
